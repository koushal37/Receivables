# Copy to frontend/.env and fill in real values. Never commit .env.
# Only VITE_* variables are exposed to the browser - never put secrets here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# API base path used by the browser (default: /api via the Vite proxy)
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api requests
VITE_BACKEND_URL=http://localhost:5001
