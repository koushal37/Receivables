# Copy to backend/.env and fill in real values. Never commit .env.

# Supabase project URL and service-role key (server only - never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=5001
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Number of proxy hops in front of the app (set to 1 on Render/Railway/Fly; leave empty locally)
TRUST_PROXY=

# WhatsApp Cloud API (optional - reminders run in mock mode when unset)
META_WHATSAPP_TOKEN=
META_PHONE_ID=
META_REMINDER_TEMPLATE=
META_TEMPLATE_LANG=en
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
